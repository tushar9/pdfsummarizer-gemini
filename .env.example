# Copy to .env and fill in your key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Pipeline tuning
TEMPERATURE=0.3
MAX_TOKENS_PER_CHUNK=8000
# Free-tier keys are happier with 2 concurrent chunk requests
MAX_CONCURRENCY=2

# OCR fallback for scanned PDFs (needs the Tesseract binary, see README)
OCR_ENABLED=true
OCR_DPI=200
OCR_MAX_PAGES=30
OCR_LANG=eng
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
